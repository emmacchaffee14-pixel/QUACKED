import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const ADMIN_OVERRIDE_PASSWORD = Deno.env.get("ADMIN_OVERRIDE_PASSWORD");

Deno.serve(async (req) => {
  try {
    const { user_id, case_difficulty, admin_password } = await req.json();

    // Admin override — bypasses all gate checks
    if (ADMIN_OVERRIDE_PASSWORD && admin_password === ADMIN_OVERRIDE_PASSWORD) {
      return new Response(
        JSON.stringify({ allowed: true, reason: "admin_override" }),
        { headers: { "Content-Type": "application/json" } }
      );
    }

    // Connect to Supabase
    const supabase = createClient(
      Deno.env.get("SUPABASE_URL")!,
      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
    );

    // Fetch user profile
    const { data: profile, error } = await supabase
      .from("user_profiles")
      .select("is_admin, is_paid, daily_drill_count, last_drill_date, xp")
      .eq("id", user_id)
      .single();

    if (error || !profile) {
      return new Response(
        JSON.stringify({ allowed: false, reason: "user_not_found" }),
        { status: 404 }
      );
    }

    // Admin account — full access
    if (profile.is_admin) {
      return new Response(
        JSON.stringify({ allowed: true, reason: "admin_account" }),
        { headers: { "Content-Type": "application/json" } }
      );
    }

    // Paid user — full access
    if (profile.is_paid) {
      return new Response(
        JSON.stringify({ allowed: true, reason: "paid_user" }),
        { headers: { "Content-Type": "application/json" } }
      );
    }

    // --- FREE USER CHECKS ---

    // Reset daily count if last drill was not today
    const today = new Date().toISOString().split("T")[0];
    let daily_count = profile.daily_drill_count;

    if (profile.last_drill_date !== today) {
      daily_count = 0;
      await supabase
        .from("user_profiles")
        .update({ daily_drill_count: 0, last_drill_date: today })
        .eq("id", user_id);
    }

    // Gate A — volume check (5 drills per day)
    if (daily_count >= 5) {
      return new Response(
        JSON.stringify({
          allowed: false,
          reason: "daily_limit_reached",
          message: "You've used your 5 free drills today. Upgrade to keep drilling.",
          upgrade_prompt: true,
        }),
        { headers: { "Content-Type": "application/json" } }
      );
    }

    // Gate C — tier check
    // Determine user tier from XP
    const getUserTier = (xp: number) => {
      if (xp >= 600) return "fully_quacked";
      if (xp >= 200) return "billable_bird";
      return "duckling";
    };

    const user_tier = getUserTier(profile.xp);
    const tier_order: Record<string, number> = {
      duckling: 0,
      billable_bird: 1,
      fully_quacked: 2,
    };

    const user_tier_level = tier_order[user_tier] ?? 0;
    const case_tier_level = tier_order[case_difficulty] ?? 0;

    if (user_tier_level < case_tier_level) {
      return new Response(
        JSON.stringify({
          allowed: false,
          reason: "tier_locked",
          message: `You've mastered ${user_tier.replace("_", " ")}. Upgrade to unlock ${case_difficulty.replace("_", " ")}.`,
          upgrade_prompt: true,
          user_tier,
        }),
        { headers: { "Content-Type": "application/json" } }
      );
    }

    // All checks passed — increment daily count and allow
    await supabase
      .from("user_profiles")
      .update({
        daily_drill_count: daily_count + 1,
        last_drill_date: today,
      })
      .eq("id", user_id);

    return new Response(
      JSON.stringify({
        allowed: true,
        reason: "free_user_allowed",
        drills_remaining: 4 - daily_count,
        user_tier,
      }),
      { headers: { "Content-Type": "application/json" } }
    );

  } catch (err) {
    return new Response(
      JSON.stringify({ error: String(err) }),
      { status: 500 }
    );
  }
});